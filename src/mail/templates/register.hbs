<style>
.container {
    font-family: Arial, Helvetica, sans-serif;
}

.header {
    padding: 0.5rem;
    background-color: rgb(233, 233, 233);
    color: #222;
    border-radius: 0.25rem;
}

p {
    font-size: 18px;
}

.name {
    font-style: oblique;
}

.link {
    background-color: #2577b9;
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    text-decoration: none;
}
</style>

<div class="container">
    <h2 class="header">Hello, {{email}}</h2>
    <p>This email was sent to you by <strong class="name">{{serverName}}</strong> at <strong>{{date}}</strong> to verify your email</p>
    <a  href={{verificationLink}} class="link">Verify</a>
</div>