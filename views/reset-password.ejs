<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
    <style>
      .form {
        font-family: Arial;
        width: 90%;
        max-width: 650px;
        margin-inline: auto;
        margin-block: 2rem;
        padding: 1rem;
        background-color: #eee;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: 0.25rem 0.25rem #333;
      }

      .form__label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      input,
      button {
        border-radius: 0;
        outline: 0;
        border: 0.15rem solid #333;
        padding: 0.25rem;
      }

      button {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <form
      id="form"
      class="form"
      method="post"
      action="/api/users/auth/reset-password/<%= userId %>/<%= resetPasswordToken %>"
    >
      <h3>
        Hi <strong><%= email %></strong>, complete the form to reset your
        password
      </h3>
      <label class="form__label">
        Password
        <input
          id="password"
          type="password"
          required
          minlength="8"
          name="password"
        />
      </label>

      <label class="form__label">
        Confirm Password
        <input
          id="confirmPassword"
          type="password"
          required
          minlength="8"
          name="confirmPassword"
        />
      </label>

      <button type="submit">Submit</button>
    </form>
  </body>
</html>
